# MediCare+ Environment Configuration Template
# Copy this file to .env and supply actual values for your local environment.
# DO NOT commit real secrets or credentials to version control.

# Application Configuration
APP_ENV=development
APP_NAME="MediCare+"
DEBUG=True
PORT=8000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicare_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
