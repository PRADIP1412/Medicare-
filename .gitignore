# MediCare+ Version Control Ignore Rules

# Python & Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Testing & Linting Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
.coverage.*
*.cover
htmlcov/

# Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.pfx
*.cert
*.crt
id_rsa*

# Local Uploads, Media & Storage
uploads/
storage/
temp/
tmp/

# Database Dumps & Local Backups
*.sql
*.dump
*.tar
*.gz
backups/

# AI Models, Weights & Large Artifacts
models/
*.bin
*.safetensors
*.gguf
*.onnx
*.pt
*.pth
*.h5

# Node.js & Frontend Artifacts
node_modules/
.next/
out/
build/
dist/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
